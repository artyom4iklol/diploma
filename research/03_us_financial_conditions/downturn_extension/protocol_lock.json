  "us_curve": "GS10 - TB3MS, monthly series averaged over three months; bill is on discount basis; this is a defined long-history proxy, not official constant-maturity T10Y3MM",
  "us_credit": "BAA10YM monthly, three-month mean",
  "equity": "100*log(mean monthly EURO STOXX 50 level this quarter / preceding quarter); price-index change, not dividend return",
  "vix": "arithmetic mean of nonmissing daily closes per quarter",
  "new_ciss": "arithmetic mean of nonmissing ECB daily NEW CISS; not the legacy weekly indicator; retrospective control",
  "estimator": "Firth logistic regression with FLIC intercept correction, training-only standardisation, no hyperparameter/model/lag search",
  "estimator_settings": {
    "max_iter": 150,
    "tolerance": 1e-08,
    "probability_clip_logloss": 1e-12
  },
  "baseline_frequency": "(positives+0.5)/(n+1), fixed Jeffreys smoothing",
  "warning_threshold": 0.2,
  "warning_status": "illustrative fixed probability threshold, not an estimated economic optimum",
  "bootstrap": {
    "replicates": 4999,
    "seed": 20261031,
